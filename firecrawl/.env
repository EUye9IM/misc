# ===== Required ENVS ======
PORT=3002
HOST=0.0.0.0
USE_DB_AUTHENTICATION=false

# ===== Optional ENVS ======
BULL_AUTH_KEY=firecrawl-admin-key-change-me

# === PostgreSQL Database Configuration ===
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=firecrawl_password
POSTGRES_DB=firecrawl

# === Use your proxy if available ===
# PROXY_SERVER= [REDACTED - set in /opt/firecrawl/.env]
